<Window x:Class="AclMap.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ACL Map" Height="940" Width="1500" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/AclMap.ico" Background="#F6F7F9">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />
        <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="660">
            <TextBlock Text="ACL Map" FontSize="22" FontWeight="SemiBold" Foreground="#1D2330" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Démarrage…" FontSize="14" Foreground="#5B6475" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="StatusLink" Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/" RequestNavigate="OnRequestNavigate">Télécharger le runtime Microsoft Edge WebView2 (Evergreen)</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
