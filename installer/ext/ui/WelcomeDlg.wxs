<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <UI>
            <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="Installation de [ProductName]">
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Suivant">
                    <Publish Property="WixUI_InstallMode" Value="Update" Condition="Installed AND PATCH" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Annuler">
                    <Publish Event="SpawnDialog" Value="CancelDlg" />
                </Control>
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Précédent" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="Cet assistant va installer [ProductName] sur cet ordinateur. Cliquez sur Suivant pour continuer ou sur Annuler pour quitter." ShowCondition="NOT Installed OR NOT PATCH" HideCondition="Installed AND PATCH" />
                <Control Id="PatchDescription" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="Cet assistant va mettre à jour [ProductName]. Cliquez sur Suivant pour continuer ou sur Annuler pour quitter." ShowCondition="Installed AND PATCH" HideCondition="NOT Installed OR NOT PATCH" />
                <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Bienvenue dans l'installation de [ProductName]" />
            </Dialog>

            <InstallUISequence>
                <Show Dialog="WelcomeDlg" Before="ProgressDlg" Overridable="yes" Condition="NOT Installed OR PATCH" />
            </InstallUISequence>
        </UI>
    </Fragment>
</Wix>
