<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <UI>
            <Property Id="WixUIRMOption" Value="UseRM" />
            <Dialog Id="MsiRMFilesInUse" Width="370" Height="270" Title="Installation de [ProductName]" KeepModeless="yes">
                <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="OK">
                    <Publish Event="EndDialog" Value="Return" />
                    <Publish Event="RMShutdownAndRestart" Value="0" Condition="WixUIRMOption~=&quot;UseRM&quot;" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Annuler">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>

                <Control Id="ShutdownOption" Type="RadioButtonGroup" X="26" Y="190" Width="305" Height="45" Property="WixUIRMOption">
                    <RadioButtonGroup Property="WixUIRMOption">
                        <RadioButton Value="UseRM" X="0" Y="0" Width="295" Height="16" Text="Fermer les applications et tenter de les redémarrer." />
                        <RadioButton Value="DontUseRM" X="0" Y="20" Width="295" Height="16" Text="Ne pas fermer les applications (un redémarrage sera nécessaire)." />
                    </RadioButtonGroup>
                </Control>

                <Control Id="List" Type="ListBox" X="20" Y="100" Width="330" Height="80" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="Text" Type="Text" X="20" Y="55" Width="330" Height="45" Text="Les applications suivantes utilisent des fichiers à mettre à jour. L'assistant peut les fermer et tenter de les redémarrer, ou vous pouvez redémarrer l'ordinateur plus tard." />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="20" Y="23" Width="280" Height="20" Transparent="yes" NoPrefix="yes" Text="Certains fichiers à mettre à jour sont en cours d'utilisation." />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Fichiers en cours d'utilisation" />
            </Dialog>
        </UI>
    </Fragment>
</Wix>
