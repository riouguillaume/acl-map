<Project>
  <!-- Paramètres communs à tous les projets de la solution ACL Map -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Les types publics principaux sont documentés ; l'absence de commentaire sur un membre trivial n'est pas bloquante. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Company>Dam-ITSECURITY</Company>
    <Product>ACL Map</Product>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
